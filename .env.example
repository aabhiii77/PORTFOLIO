# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ----------------------------------------------------------------------------
# Python FastAPI Contact Backend (Render / Local Uvicorn)
# ----------------------------------------------------------------------------
# Generate a Google App Password in Google Account -> Security -> App passwords
# (requires 2-Step Verification) and set SMTP_APP_PASSWORD securely in Render
# Environment Variables. Never commit real secrets.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=aayushikoomar@gmail.com
SMTP_APP_PASSWORD=
CONTACT_RECIPIENT_EMAIL=aayushikoomar@gmail.com
SMTP_TIMEOUT_SECONDS=15

# Explicit comma-separated allowed CORS origins for the deployed Render API
# Include your production frontend origin (e.g. https://aayushi-portfolio.vercel.app)
ALLOWED_ORIGINS=https://your-portfolio-frontend.vercel.app

# ----------------------------------------------------------------------------
# Frontend Environment Variable (Vercel / Vite Build)
# ----------------------------------------------------------------------------
# Set this to your deployed Render FastAPI service base URL (no trailing slash),
# e.g. https://aayushi-portfolio-api.onrender.com
# Leave empty during local `npm run dev` to use the same-origin `/api` proxy.
VITE_API_BASE_URL=
